# Heroku's Rust buildpack (emk/heroku-buildpack-rust) reads this file.
#
# Without this, a bare `cargo build --release` builds every workspace member,
# including `desktop` (the Tauri app) and `wasm` — neither runs on a Heroku
# web dyno, and `desktop` pulls in webkit2gtk/libsoup3/GTK, which is why the
# Heroku build needed an ever-growing Aptfile just to link a binary nothing
# deploys. Restrict the build to the one binary Heroku actually runs.
RUST_CARGO_BUILD_FLAGS="--release -p atomic-server --bin atomic-server"

# This deployment must include a functioning server-side plugin runtime.
export ATOMICSERVER_REQUIRE_PLUGIN_RUNTIME=true
# The Apt buildpack extracts LLVM outside the system library search path.
export LIBCLANG_PATH="$BUILD_DIR/.apt/usr/lib/llvm-18/lib"
export BINDGEN_EXTRA_CLANG_ARGS="-resource-dir=$BUILD_DIR/.apt/usr/lib/llvm-18/lib/clang/18"
